# areax-rag-service: environment variables (names only; see docs/environment-variables.md)
#
# Copy this file to .env and fill in the values:   cp .env.example .env
# .env is gitignored. NEVER commit real values.
#
# The services run on your machine and reach Postgres, Kafka and Floci on the VPS through the
# SSH tunnel (see ../areax-rag-infra/docs/ports-and-tunnels.md).
# Each service reads only the variables it needs; both use one shared file for now.

# ---- Shared by both services ---------------------------------------------------------------
# Kafka (EXTERNAL listener through the tunnel)
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# Postgres (use the application role created by the infra compose file)
DATABASE_URL=postgresql://areax_app:CHANGE_ME@localhost:5432/areax_rag

# S3 and S3 Vectors on Floci (the credentials are dummy values, never real AWS keys)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=areax-rag-documents
VECTOR_BUCKET=areax-rag-vectors
VECTOR_INDEX=areax-rag-chunks

# OpenAI. The key belongs here only, never in the application or the repository.
OPENAI_API_KEY=
# The index dimension must match this model (1536 for text-embedding-3-small).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

LOG_LEVEL=INFO
# Attempts before a message goes to the dead-letter topic
MAX_ATTEMPTS=5

# ---- ingestion service ---------------------------------------------------------------------
# Single file size limit: 50 MB
FILE_MAX_BYTES=52428800
# To be decided (required, no default on purpose)
CHUNK_SIZE=
CHUNK_OVERLAP=

# ---- chat service --------------------------------------------------------------------------
# Low-cost chat model; the name is not decided yet
OPENAI_CHAT_MODEL=
# To be decided (required, no default on purpose)
RETRIEVAL_TOP_K=
MAX_HISTORY_MESSAGES=
MAX_OUTPUT_TOKENS=
TOKEN_BATCH_SIZE=
