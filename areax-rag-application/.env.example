# areax-rag-application: environment variables (names only; see docs/environment-variables.md)
#
# Copy this file to .env and fill in the values:   cp .env.example .env
# .env is gitignored. NEVER commit real values.
#
# The application runs on your machine and reaches Postgres, Kafka and Floci on the VPS
# through the SSH tunnel (see ../areax-rag-infra/docs/ports-and-tunnels.md).

# ---- Database (Postgres through the tunnel) -----------------------------------------------
# User and password are POSTGRES_USER and POSTGRES_PASSWORD of the infra compose file. The database
# areax_rag is created by hand first (see ../areax-rag-infra/docs/postgres.md).
# If you map the tunnel to another local port (for example 5433), change it here.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/areax_rag

# ---- Authentication ------------------------------------------------------------------------
# Auth.js secret. Generate one with:  openssl rand -base64 32
AUTH_SECRET=
# bcrypt cost factor (12 or higher)
BCRYPT_COST=12

# ---- Kafka (EXTERNAL listener through the tunnel) -----------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# ---- S3 on Floci (virtual AWS; the credentials are dummy values, never real AWS keys) -----
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Bucket name from the CloudFormation stack output (areax-rag-infra)
S3_BUCKET=areax-rag-documents
# Address the BROWSER uses for presigned upload URLs. Leave empty to use AWS_ENDPOINT_URL. Set it when the
# browser reaches Floci on a different address than the server does (for example through the tunnel).
S3_PUBLIC_ENDPOINT=

# ---- Limits --------------------------------------------------------------------------------
# Total size of all files in one project: 100 MB
PROJECT_MAX_TOTAL_BYTES=104857600
# Size of a single file: 50 MB
FILE_MAX_BYTES=52428800

# ---- Seed script ---------------------------------------------------------------------------
# Password for the seeded accounts. When empty, a random password is generated and printed once.
SEED_PASSWORD=
# Comma-separated accounts to create with `npm run db:seed` (no sign-up screen exists).
# Write name:password to give one account its own password, for example alice:secret,bob
SEED_USERNAMES=

# ---- UI development without a server -----------------------------------------------------
# true = the browser uses the in-memory mock API (see README). Leave false once the server exists.
NEXT_PUBLIC_USE_MOCK_API=false

# ---- Logging -------------------------------------------------------------------------------
LOG_LEVEL=info

# Not set here on purpose: the OpenAI API key belongs only to the Python services.
