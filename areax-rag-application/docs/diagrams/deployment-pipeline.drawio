<mxfile host="app.diagrams.net"><diagram name="Deployment pipeline" id="deployment-pipeline"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;areax-rag-application: deployment pipeline&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="800" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Developer&lt;/b&gt;&lt;br&gt;works on &lt;b&gt;develop&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="150" height="70" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;GitHub repository&lt;/b&gt;&lt;br&gt;merge develop into&lt;br&gt;&lt;b&gt;deployment/prod&lt;/b&gt;&lt;br&gt;(restricted branch)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230" y="120" width="170" height="90" as="geometry"/></mxCell><mxCell id="c5" value="GitHub Actions: application-deploy.yml" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="440" y="60" width="560" height="480" as="geometry"/></mxCell><mxCell id="c6" value="job 1: build" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="460" y="100" width="520" height="190" as="geometry"/></mxCell><mxCell id="c7" value="checkout" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="140" width="90" height="40" as="geometry"/></mxCell><mxCell id="c8" value="buildx +&lt;br&gt;docker login" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="140" width="100" height="40" as="geometry"/></mxCell><mxCell id="c9" value="docker build&lt;br&gt;(Next.js standalone)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="140" width="130" height="40" as="geometry"/></mxCell><mxCell id="c10" value="push tags&lt;br&gt;application-&amp;lt;sha&amp;gt;&lt;br&gt;application-latest" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="125" width="110" height="70" as="geometry"/></mxCell><mxCell id="c11" value="Runs only for pushes to deployment/prod that touch areax-rag-application/**; one deploy at a time (concurrency group). npm ci, then next build: a type error fails the run. No lint or test gate (decision)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="205" width="480" height="60" as="geometry"/></mxCell><mxCell id="c12" value="job 2: deploy  (environment: prod)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="460" y="310" width="520" height="210" as="geometry"/></mxCell><mxCell id="c13" value="prepare SSH&lt;br&gt;key + pinned&lt;br&gt;known_hosts" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="360" width="110" height="60" as="geometry"/></mxCell><mxCell id="c14" value="scp compose.yml&lt;br&gt;+ deploy.sh" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="360" width="110" height="60" as="geometry"/></mxCell><mxCell id="c15" value="ssh: run&lt;br&gt;deploy.sh &amp;lt;image&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="360" width="120" height="60" as="geometry"/></mxCell><mxCell id="c16" value="Optional: required reviewers on the production environment approve each deploy." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="440" width="480" height="40" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;GitHub secrets / variables&lt;/b&gt;&lt;br&gt;DOCKERHUB_USERNAME, DOCKERHUB_TOKEN&lt;br&gt;VPS_HOST, VPS_USER, VPS_SSH_KEY, VPS_KNOWN_HOSTS&lt;br&gt;var: DOCKERHUB_REPOSITORY" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="440" y="590" width="560" height="80" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Docker Hub&lt;/b&gt; (public or private repo)&lt;br&gt;one repo, tag per component:&lt;br&gt;application-&amp;lt;sha&amp;gt;&lt;br&gt;application-latest" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1060" y="130" width="200" height="100" as="geometry"/></mxCell><mxCell id="c19" value="VPS (deploy user, SSH only; app port 3000 open)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1040" y="300" width="520" height="480" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;deploy.sh&lt;/b&gt;&lt;br&gt;1. read .current-image&lt;br&gt;2. docker compose pull&lt;br&gt;3. docker compose up -d" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1060" y="350" width="230" height="90" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;application container&lt;/b&gt;&lt;br&gt;network_mode: host, env_file: application.env (only on the VPS)&lt;br&gt;reaches Postgres, Kafka, Floci on 127.0.0.1 (started by hand)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1320" y="350" width="220" height="110" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;health check&lt;/b&gt;&lt;br&gt;GET :3000/login&lt;br&gt;200 within 60 s?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1060" y="480" width="230" height="80" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;healthy&lt;/b&gt;&lt;br&gt;write .current-image&lt;br&gt;prune old images" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1320" y="480" width="220" height="80" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;unhealthy&lt;/b&gt;&lt;br&gt;print logs, run the previous&lt;br&gt;image, exit 1 (run turns red)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1060" y="600" width="230" height="80" as="geometry"/></mxCell><mxCell id="c25" value="git push / merge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="push event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="needs: build (image reference)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="c6" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="docker push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="c10" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="used by the jobs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=11;dashed=1;" edge="1" parent="1" source="c17" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="ssh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="c15" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="docker pull (login needed only if private)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=11;dashed=1;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="up -d" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="c20" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="c22" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Manual rollback:&lt;/b&gt; on the VPS run &lt;i&gt;./deploy.sh &amp;lt;user&amp;gt;/&amp;lt;repo&amp;gt;:application-&amp;lt;older-sha&amp;gt;&lt;/i&gt;. Older tags stay on Docker Hub." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSi