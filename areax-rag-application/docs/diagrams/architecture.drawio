<mxfile host="app.diagrams.net"><diagram name="Architecture" id="architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;areax-rag: system architecture&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;areax-rag-mcp&lt;/b&gt;&lt;br&gt;planned, not implemented" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#666666;fontSize=12;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="150" height="60" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;React UI&lt;br&gt;one EventSource per tab" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="150" height="240" as="geometry"/></mxCell><mxCell id="c5" value="areax-rag-application (Next.js, public, HTTP :3000)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="240" y="100" width="400" height="520" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;UI pages&lt;/b&gt;&lt;br&gt;login, home, project&lt;br&gt;(atomic design, SCSS, MUI)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="260" y="140" width="360" height="60" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Route handlers&lt;/b&gt; /api/**&lt;br&gt;zod validation, ApiResponse envelope" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="260" y="220" width="360" height="60" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Services &amp;rarr; Repositories&lt;/b&gt;&lt;br&gt;permission checks on every request&lt;br&gt;(Auth.js + bcrypt, Prisma)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="260" y="300" width="360" height="70" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Kafka client&lt;/b&gt;&lt;br&gt;producer + consumer singletons" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="260" y="390" width="360" height="60" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;SSE hub&lt;/b&gt; GET /api/events&lt;br&gt;userId &amp;rarr; open connections" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="260" y="470" width="360" height="60" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;S3 client&lt;/b&gt;&lt;br&gt;presigned URLs, HEAD, delete" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="260" y="550" width="360" height="50" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Kafka&lt;/b&gt; (KRaft, single broker)&lt;br&gt;&lt;br&gt;areax.document.events&lt;br&gt;areax.chat.requests&lt;br&gt;areax.chat.tokens (1 h)&lt;br&gt;areax.dlq" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="335" width="220" height="170" as="geometry"/></mxCell><mxCell id="c13" value="areax-rag-service (Python, one image, two entry points)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1040" y="100" width="360" height="480" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Ingestion service&lt;/b&gt;&lt;br&gt;extract text (PDF, DOCX, MD, TXT)&lt;br&gt;YouTube captions&lt;br&gt;chunk &amp;rarr; embed &amp;rarr; write vectors&lt;br&gt;idempotent, at-least-once" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1060" y="150" width="320" height="120" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Chat service&lt;/b&gt;&lt;br&gt;embed question &amp;rarr; query vectors&lt;br&gt;stream answer tokens&lt;br&gt;save the full answer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1060" y="350" width="320" height="110" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;OpenAI API&lt;/b&gt;&lt;br&gt;embeddings, chat completion" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="10" width="170" height="55" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;YouTube&lt;/b&gt;&lt;br&gt;captions" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1230" y="10" width="170" height="55" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Postgres 16&lt;/b&gt; (VPS)&lt;br&gt;schema owned by the application&lt;br&gt;(Prisma migrations)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="700" width="220" height="100" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Floci&lt;/b&gt; (virtual AWS, VPS)&lt;br&gt;S3 bucket: documents&lt;br&gt;S3 Vectors: chunk index&lt;br&gt;(CloudFormation stack)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="700" width="360" height="100" as="geometry"/></mxCell><mxCell id="c20" value="1. HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=11;verticalLabelPosition=top;verticalAlign=bottom;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="6. SSE tokens" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#b85450;fontSize=11;verticalLabelPosition=top;verticalAlign=bottom;exitX=0;exitY=0.5;entryX=1;entryY=0.85;" edge="1" parent="1" source="c10" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="2. presigned PUT (file upload)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=11;dashed=1;verticalLabelPosition=bottom;verticalAlign=top;exitX=0.5;exitY=1;entryX=0.8;entryY=1;" edge="1" parent="1" source="c4" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="3. requests / tokens" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=11;verticalLabelPosition=top;verticalAlign=bottom;startArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c9" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="4a. document.events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=11;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="4b. chat.requests / chat.tokens" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=11;startArrow=block;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="c12" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="Prisma: read / write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=11;exitX=0.9;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="c5" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="presign, HEAD, delete" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=11;dashed=1;verticalLabelPosition=top;verticalAlign=bottom;exitX=0.5;exitY=1;entryX=0.2;entryY=1;" edge="1" parent="1" source="c5" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="document status, saved answers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=11;exitX=0.2;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="c13" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="read file, write + query vectors" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c13" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="embeddings, answer stream" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=11;exitX=0.25;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c13" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="captions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=11;exitX=0.75;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c13" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;blue: application (public)&lt;br&gt;green: Python services (internal)&lt;br&gt;orange: VPS infrastructure (ports on 127.0.0.1)&lt;br&gt;grey: external or planned&lt;br&gt;red arrow: answer tokens" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="330" height="100" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;This phase:&lt;/b&gt; the application and the services run on your own machine and reach Postgres, Kafka and Floci on the VPS through an SSH tunnel (5432, 9094, 4566). Only the application is ever public. The services call OpenAI and YouTube directly; the browser never does. Python services are not implemented yet." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="860" width="640" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>