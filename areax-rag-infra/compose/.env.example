# Copy to compose/.env on the VPS and fill in the empty values.
# compose/.env is gitignored. NEVER commit real passwords.

# ---- Postgres -----------------------------------------------------------------------------
# Admin account (used only to create the application role and database on first start)
POSTGRES_ADMIN_USER=postgres_admin
POSTGRES_ADMIN_PASSWORD=
# Application role and database (the application and the Python services connect with these)
APP_DB_USER=areax_app
APP_DB_PASSWORD=
APP_DB_NAME=areax_rag
POSTGRES_MEM_LIMIT=512m

# ---- Kafka --------------------------------------------------------------------------------
# Address the broker advertises to clients on your machine (through the SSH tunnel)
KAFKA_EXTERNAL_ADVERTISED=localhost:9094
KAFKA_HEAP_OPTS="-Xms256m -Xmx512m"
KAFKA_MEM_LIMIT=768m

# ---- Floci --------------------------------------------------------------------------------
FLOCI_VERSION=2.4.0
FLOCI_STORAGE_MODE=hybrid
FLOCI_MEM_LIMIT=1g
# Set to an existing volume name to reuse old Floci data (see `docker volume ls`)
FLOCI_VOLUME=areax-rag-floci-data
