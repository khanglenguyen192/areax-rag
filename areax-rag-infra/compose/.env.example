# Copy to compose/.env on the VPS and fill in the empty values.
# compose/.env is gitignored. NEVER commit real passwords.

# ---- Postgres -----------------------------------------------------------------------------
# The image creates this user (a superuser of this private cluster) and database on the first
# start. Application databases are created later with CREATE DATABASE (see docs/postgres.md).
# Use a long random password. Changing these later does not alter an existing data volume.
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_MEM_LIMIT=512m

# ---- Kafka --------------------------------------------------------------------------------
# Address the broker advertises to clients on your machine (through the SSH tunnel)
KAFKA_EXTERNAL_ADVERTISED=localhost:9094
KAFKA_HEAP_OPTS="-Xms256m -Xmx512m"
KAFKA_MEM_LIMIT=768m

# ---- Floci --------------------------------------------------------------------------------
FLOCI_VERSION=2.4.0
FLOCI_STORAGE_MODE=hybrid
FLOCI_MEM_LIMIT=1g
# Only when recreating Floci from compose/floci.compose.yml: the name of the volume that holds the
# existing data (see `docker volume ls`), so nothing is lost.
FLOCI_VOLUME=areax-rag-floci-data
